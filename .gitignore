# Skills
skills-lock.json

# Superpowers brainstorm sessions
.superpowers/

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/
app/.cxx/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio
*.iml
.idea/

# VS Code
.vscode/
.DS_Store
.kotlin/

# NDK
obj/

# Node.js mobile binaries (auto-downloaded by Gradle task)
app/libnode/

# Signing keys — NEVER commit these
*.jks
*.keystore
*.pem
*.p12
*.p8
*.bks
*.cer
signing.properties
keystore.properties

# dApp Store publishing — keypairs and local config
publishing/node_modules/
publishing/.cache/
publishing/*.json
!publishing/package.json
publisher-keypair.json
*-keypair.json

# Firebase config (contains project-specific API keys)
app/google-services.json

# OpenClaw reference (tracked separately)
openclaw-reference/

# Environment secrets
.env
.env.*
!.env.example

# Agent/tooling configs
.agent/
.agents/
.claude/
.cline/
.codex/
.continue/
.cursor/
.gemini/
.opencode/
.windsurf/
/skills/
# Bundled agent skills must be tracked (extracted to device on first launch)
!app/src/main/assets/nodejs-project/workspace/skills/

# Build debug artifacts
build_output.txt
compile_out.txt

# Developer-specific MCP config
.mcp.json
node_debug.log

# Jupiter test fixtures — only the canonical pinned snapshots are tracked
# (named *-pinned.json). Audit-trail timestamped captures stay local.
tests/jupiter-ultra/fixtures/sim-deposit-[0-9]*.json
tests/jupiter-ultra/fixtures/v2-flow-*.json
tests/jupiter-ultra/node_modules/
tests/jupiter-ultra/package-lock.json.local-backup
tests/jupiter-ultra/package.json.local-backup

# JVM crash dumps (from local Gradle/Android Studio builds)
hs_err_pid*.log
replay_pid*.log
