# tests/xai-models/.env.example — copy to .env.test (GITIGNORED) and fill in.
# Provide AT LEAST ONE credential. If you provide both, both paths are tested.
# NEVER commit .env.test. The harness never prints token material.

# console.x.ai API key — the api_key path. Easiest to obtain; answers
# "does grok-4.5 exist for my account" and "what params does it need".
XAI_API_KEY=

# SuperGrok / X Premium+ OAuth access token — the DEVICE path (the agent uses
# OAuth on-device). Hard to obtain by hand; if you can't paste one, run the
# harness with `--login` instead — it does the "Sign in with Grok" flow in a
# browser and keeps the token in memory only (nothing written to disk).
XAI_OAUTH_TOKEN=

# Optional: override the inference base (self-hosted gateway / proxy).
# Blank = api.x.ai. Accepts protocol + host + port, e.g. http://127.0.0.1:8080
XAI_BASE_URL=
