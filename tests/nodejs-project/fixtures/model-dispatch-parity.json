{
  "_comment": "BAT-1661 (contract v2.9 §1/§3, v2.10 §3): ONE table, two runners. model-dispatch-parity.test.js boots the REAL config.js per row; app/src/test/.../ModelDispatchParityTest.kt runs NodeDispatch.winner and ModelRepair.transportOf. A row changes only here. runtime/overlay: an object is written as JSON, a string is written verbatim, null means no file. Models are markers: m-overlay, m-runtime, m-config (config.json's model).",
  "dispatch": [
    { "name": "overlay names the running provider", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": "openai", "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "overlay with no provider counts as ours", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "overlay with a blank provider counts as ours", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": "  ", "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "overlay provider that is not a string counts as ours", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": 7, "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "overlay values are trimmed", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": " openai ", "model": "  m-overlay  " }, "expect": "OVERLAY" },
    { "name": "overlay with a blank model does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": "openai", "model": "   " }, "expect": "RUNTIME" },
    { "name": "overlay with no model does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "heartbeatIntervalMinutes": 30 }, "expect": "RUNTIME" },
    { "name": "overlay model that is not a string does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "model": 42 }, "expect": "RUNTIME" },
    { "name": "overlay for another provider does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": "claude", "model": "m-overlay" }, "expect": "RUNTIME" },
    { "name": "corrupt overlay does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": "{not json", "expect": "RUNTIME" },
    { "name": "overlay that is an array does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": "[1,2]", "expect": "RUNTIME" },
    { "name": "overlay that is null does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": "null", "expect": "RUNTIME" },
    { "name": "no overlay - runtime_state", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "m-runtime" }, "overlay": null, "expect": "RUNTIME" },
    { "name": "runtime_state model is trimmed", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "  m-runtime  " }, "overlay": null, "expect": "RUNTIME" },
    { "name": "runtime_state with a blank model does not count", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "   " }, "overlay": null, "expect": "CONFIG" },
    { "name": "runtime_state and overlay both blank - config.json", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": "" }, "overlay": { "model": " " }, "expect": "CONFIG" },
    { "name": "runtime_state outside the matrix is ignored", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "setup_token", "model": "m-runtime" }, "overlay": null, "expect": "CONFIG" },
    { "name": "runtime_state with a non-canonical provider is ignored (raw matrix check)", "configProvider": "openai", "runtime": { "provider": "OpenAI", "authType": "api_key", "model": "m-runtime" }, "overlay": null, "expect": "CONFIG" },
    { "name": "runtime_state with no model field is ignored", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key" }, "overlay": null, "expect": "CONFIG" },
    { "name": "runtime_state model that is not a string is ignored", "configProvider": "openai", "runtime": { "provider": "openai", "authType": "api_key", "model": 5 }, "overlay": null, "expect": "CONFIG" },
    { "name": "corrupt runtime_state is ignored", "configProvider": "openai", "runtime": "{not json", "overlay": null, "expect": "CONFIG" },
    { "name": "no files - config.json", "configProvider": "openai", "runtime": null, "overlay": null, "expect": "CONFIG" },
    { "name": "no runtime_state, overlay with no provider", "configProvider": "openai", "runtime": null, "overlay": { "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "no runtime_state, overlay names config.json's provider", "configProvider": "openai", "runtime": null, "overlay": { "provider": "openai", "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "no runtime_state, overlay names another provider", "configProvider": "openai", "runtime": null, "overlay": { "provider": "claude", "model": "m-overlay" }, "expect": "CONFIG" },
    { "name": "the running provider is runtime_state's - overlay naming config.json's is foreign", "configProvider": "openai", "runtime": { "provider": "claude", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": "openai", "model": "m-overlay" }, "expect": "RUNTIME" },
    { "name": "the running provider is runtime_state's - overlay naming it applies", "configProvider": "openai", "runtime": { "provider": "claude", "authType": "api_key", "model": "m-runtime" }, "overlay": { "provider": "claude", "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "an unknown config.json provider runs as claude", "configProvider": "bogus", "runtime": null, "overlay": { "provider": "claude", "model": "m-overlay" }, "expect": "OVERLAY" },
    { "name": "invalid runtime_state - the running provider is config.json's", "configProvider": "claude", "runtime": { "provider": "openai", "authType": "setup_token", "model": "m-runtime" }, "overlay": { "provider": "openai", "model": "m-overlay" }, "expect": "CONFIG" }
  ],
  "transport": [
    { "name": "oauth + sign-in + key", "selected": "oauth", "token": true, "key": true, "expect": "OAUTH" },
    { "name": "oauth + sign-in", "selected": "oauth", "token": true, "key": false, "expect": "OAUTH" },
    { "name": "oauth + no sign-in + key", "selected": "oauth", "token": false, "key": true, "expect": "API_KEY" },
    { "name": "oauth + no sign-in + no key", "selected": "oauth", "token": false, "key": false, "expect": "RECONNECT" },
    { "name": "api_key + sign-in + key", "selected": "api_key", "token": true, "key": true, "expect": "API_KEY" },
    { "name": "api_key + key", "selected": "api_key", "token": false, "key": true, "expect": "API_KEY" },
    { "name": "runtime_state's selection wins over config.json's", "selected": "api_key", "runtimeAuth": "oauth", "token": true, "key": true, "expect": "OAUTH" },
    { "name": "runtime_state's api_key wins over config.json's oauth", "selected": "oauth", "runtimeAuth": "api_key", "token": true, "key": true, "expect": "API_KEY" }
  ]
}
