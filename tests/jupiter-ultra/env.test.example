# tests/jupiter-ultra/.env.test
#
# Copy this file to `.env.test` (which is gitignored) and fill in real values.
# These tests run AGAINST MAINNET — be careful with funded amounts.
#
# Why this template lives at `env.test.example` (no leading dot) instead of
# `.env.test.example`: the repo gitignore has a `.env.*` rule that matches
# both `.env.test` (intended — keep secrets out of git) AND
# `.env.test.example` (unintended — template was being silently ignored).
# Naming it without the `.env.` prefix sidesteps the rule so contributors
# can see the template after cloning.
#
# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED for all layers
# ──────────────────────────────────────────────────────────────────────────────

# Jupiter API key — get a free one at https://portal.jup.ag
JUPITER_API_KEY=

# Solana RPC endpoint (mainnet). Free options:
#   - https://api.mainnet-beta.solana.com  (rate-limited)
#   - https://solana-rpc.publicnode.com    (better)
#   - Helius/QuickNode/Triton if you have a key
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED for Layer 1 + 2 (probe-only — no signing, no funds at risk)
# ──────────────────────────────────────────────────────────────────────────────

# Burner public key (base58). You can use the existing on-device burner pubkey
# here OR a fresh test pubkey — it's read-only at this layer.
BURNER_PUBKEY=

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED for Layer 3 + 4 (sign + execute — real funds spent)
# ──────────────────────────────────────────────────────────────────────────────

# Burner secret key as a JSON array of 64 numbers (Solana convention).
# Generate a fresh test wallet:
#
#   node tests/jupiter-ultra/lib/generate-wallet.js
#
# (Or use the PowerShell one-liner in lib/generate-wallet.js's comments.)
# DO NOT reuse your production burner secret here. Fund the wallet with
# ~0.02 SOL on mainnet for the test budget.
BURNER_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Layer 4 (pay.sh / x402)
# ──────────────────────────────────────────────────────────────────────────────

# A pay.sh endpoint URL that returns 402 with x402 payment requirements.
# Default points at the public sandbox; override if testing a different gateway.
PAYSH_TEST_URL=https://pay.sh/quote

# Optional cap (USDC microunits — 1 USDC = 1_000_000) for x402 demand check.
# Defaults to 1_000_000 (1 USDC) if unset.
MAX_USDC_ATOMIC=1000000
